{
  "name": "yamdv",
  "version": "0.0.1",
  "private": true,
  "description": "Yet Another MarkDown Viewer",
  "author": "YAMDV",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:smoke": "npm run build && node tests/smoke.mjs",
    "format": "prettier --write src electron tests package.json index.html vite.config.js README.md"
  },
  "build": {
    "appId": "com.yamdv.app",
    "productName": "YAMDV",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "shared/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "latest",
    "vitest": "^4.1.12",
    "wait-on": "latest"
  }
}
